( write "min" )
( min 2   3   )           ; -> 2
( min 3   2   )           ; -> 2
( min 2.1 3   )           ; -> 2.1
( min 3   2.1 )           ; -> 2.1
( min 2   3.2 )           ; -> 2
( min 3.2 2   )           ; -> 2
( min 2.3 3.2 )           ; -> 2.3
( min 3.2 2.3 )           ; -> 2.3
( min 1 2.1 4 5.2 7 8.3 ) ; -> 1
( min 2.1 4 5.2 7 8.3 1 ) ; -> 1
( min 7 2.1 4 1 8.3 5.2 ) ; -> 1

( write "max" )
( max 2   3   )           ; -> 3
( max 3   2   )           ; -> 3
( max 2.1 3   )           ; -> 3
( max 3   2.1 )           ; -> 3
( max 2   3.2 )           ; -> 3.2
( max 3.2 2   )           ; -> 3.2
( max 2.3 3.2 )           ; -> 3.2
( max 3.2 2.3 )           ; -> 3.2
( max 1 2.1 4 5.2 7 8.3 ) ; -> 8.3
( max 2.1 4 5.2 7 8.3 1 ) ; -> 8.3
( max 7 2.1 4 1 8.3 5.2 ) ; -> 8.3

